# Express API base URL (no trailing slash). In development leave it as /api: the Vite dev
# server proxies /api to http://localhost:4000. Set the public API URL for production builds.
VITE_API_URL=/api
# Supabase project URL and PUBLISHABLE/anon key only.
# NEVER put the service-role / secret key in any VITE_* variable — it would ship to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
