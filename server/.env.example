# Copy to server/.env and fill in. Never commit the real file.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS)
CLIENT_URL=http://localhost:5173

# Supabase project settings (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key: used with each user's JWT so Row Level Security applies
SUPABASE_ANON_KEY=your-publishable-anon-key
# SERVER-ONLY secret / service-role key: used only to verify tokens and manage
# Auth users. Never expose this to the browser or put it in client/.env.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: only for `npm run test:live -w server` against a DEVELOPMENT project with demo data.
# LIVE_DEMO_PASSWORD=
# LIVE_ADMIN_EMAIL=
# LIVE_ADMIN_PASSWORD=
